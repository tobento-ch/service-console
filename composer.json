{
    "name": "tobento/service-console",
    "version": "2.0",
    "type": "library",
    "description": "Command Line Interface using Symfony Console as default implementation.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "console",
        "command"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "tobento/service-autowire": "^2.0",
        "symfony/console": "^7.3"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0",
        "tobento/service-event": "^2.0",
        "tobento/service-collection": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Console\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Console\\Test\\": "tests",
            "App\\": "build/src"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}